<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The MacBook app (packaging/macos/build-app.sh). Sandboxed; the network for the MasterSAT API
     (client) and for the loopback server the question pages are served from to WKWebView
     (server, 127.0.0.1 only — macos_island_host.dart). The question pages are inside the app, so
     no file access outside the sandbox is needed (the development runner's DebugProfile reads
     the repository's island build). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
