<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The MacBook app (packaging/macos/build-app.sh). NOT sandboxed, like other exam browsers: the
     midterm lock must ask other apps to quit and hide whatever comes to the front
     (NSRunningApplication terminate / hide), which a sandboxed app may not do. Distributed
     outside the App Store (Developer ID), where the sandbox is optional. The development runner
     keeps its sandboxed DebugProfile. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
