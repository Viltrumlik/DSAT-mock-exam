{
  "$comment": "Native <-> web island message protocol (architecture.md §2.7). THE single source for island/src/protocol.ts and app/lib/island/protocol.dart (both generated by desktop-native/tool/protocol/gen_protocol.py). Type grammar: 'string' | 'int' | 'number' | 'bool' | 'any' | {type:'string', maxLength?, pattern?} | {enum:[...]} | {array:T, maxItems?} | {map:T} | {ref:'Name'} | {nullable:T} | {object:{field:T, 'opt?':T}, additional?:bool}. A field name ending in '?' is optional (omitted when absent). Optional fields are never also nullable.",
  "protocol": 1,
  "envelope": {
    "v": "protocol version, always 1",
    "t": "message type (a key of `messages`)"
  },
  "directions": {
    "to_web": "native -> island: PostWebMessageAsJson; the page listens on window.chrome.webview 'message'",
    "to_native": "island -> native: window.chrome.webview.postMessage(obj); native reads WebMessageReceived and validates against this schema, dropping anything that does not match"
  },
  "types": {
    "Annotation": {
      "object": {
        "start": "int",
        "end": "int",
        "kind": {"enum": ["highlight", "underline"]},
        "color?": {"enum": ["yellow", "blue", "pink"]},
        "underline?": {"enum": ["solid", "dashed", "dotted"]}
      }
    },
    "AnnotationSet": {
      "object": {
        "passage": {"array": {"ref": "Annotation"}},
        "question": {"array": {"ref": "Annotation"}},
        "choices": {"array": {"ref": "Annotation"}}
      }
    },
    "Rect": {
      "object": {"x": "number", "y": "number", "w": "number", "h": "number"}
    },
    "AnnotationStyle": {
      "object": {
        "color?": {"enum": ["yellow", "blue", "pink"]},
        "underline?": {"enum": ["solid", "dashed", "dotted"]}
      }
    },
    "QuestionOption": {
      "object": {"text": "string", "image_key": {"nullable": "string"}},
      "additional": true
    },
    "Question": {
      "object": {
        "id": "int",
        "order": "int",
        "question_type": "string",
        "is_math_input": "bool",
        "question_text": "string",
        "question_prompt": "string",
        "question_image_key": {"nullable": "string"},
        "options": {"nullable": {"map": {"ref": "QuestionOption"}}}
      },
      "additional": true
    },
    "ReviewInfo": {
      "object": {
        "correct": "string",
        "studentAnswer": {"nullable": "string"},
        "isCorrect": "bool"
      }
    }
  },
  "messages": {
    "init": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "Sent once, after `ready`.",
      "fields": {
        "mode": {"enum": ["exam", "review"]},
        "kind": {"enum": ["pastpaper", "midterm"]},
        "subject": {"enum": ["rw", "math"]},
        "overlays": {"enum": ["native", "inline"]},
        "zoom": "number",
        "split": "number",
        "highlighterOn": "bool",
        "eliminatorOn": "bool",
        "calcReservePx": "number"
      }
    },
    "module.load": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "Every question of the module, bundle objects unchanged. The island sanitises and runs KaTeX once per question into detached fragments.",
      "fields": {
        "moduleId": "int",
        "questions": {"array": {"ref": "Question"}}
      }
    },
    "media.put": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "One image. The island makes a blob: URL and rewrites image_key / media:<key> sources.",
      "fields": {
        "key": "string",
        "mime": {"enum": ["image/png", "image/jpeg", "image/gif", "image/webp", "image/svg+xml"]},
        "b64": "string"
      }
    },
    "question.show": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "Swap the DOM to this question; never navigates. `review` only in mode:'review'.",
      "fields": {
        "qid": "int",
        "index": "int",
        "total": "int",
        "answer": {"nullable": "string"},
        "eliminated": {"array": "string"},
        "flagged": "bool",
        "annotations": {"ref": "AnnotationSet"},
        "scrollTop?": "number",
        "review?": {"ref": "ReviewInfo"}
      }
    },
    "state.patch": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "The authoritative echo once native accepted a change. A cleared answer is \"\".",
      "fields": {
        "qid": "int",
        "answer?": "string",
        "eliminated?": {"array": "string"},
        "flagged?": "bool"
      }
    },
    "view.set": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "inputLocked is set at 0:00, during the transition, the off-screen countdown and Check Your Work.",
      "fields": {
        "zoom?": "number",
        "split?": "number",
        "highlighterOn?": "bool",
        "eliminatorOn?": "bool",
        "inputLocked?": "bool",
        "calcReservePx?": "number"
      }
    },
    "annot.apply": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "Exactly one of selectionId / annotId. Runs addHighlight / addUnderline / removeRange, then mergeAnnotations; the island answers with annot.changed.",
      "fields": {
        "selectionId?": "string",
        "annotId?": "string",
        "op": {"enum": ["highlight", "underline", "remove"]},
        "color?": {"enum": ["yellow", "blue", "pink"]},
        "underline?": {"enum": ["solid", "dashed", "dotted"]}
      }
    },
    "selection.get": {
      "direction": "to_web",
      "islands": ["content"],
      "doc": "Pre-fill Report and Notes; answered by selection.current with the same req.",
      "fields": {"req": "int"}
    },
    "focus.release": {
      "direction": "to_web",
      "islands": ["content", "desmos"],
      "doc": "Give keyboard focus back to native.",
      "fields": {}
    },
    "ready": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {"build": "string", "protocol": "int"}
    },
    "module.loaded": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {"moduleId": "int", "ms": "number", "failed": {"array": "int"}}
    },
    "question.shown": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {"qid": "int", "ms": "number"}
    },
    "answer.choose": {
      "direction": "to_native",
      "islands": ["content"],
      "doc": "The island has already painted the choice.",
      "fields": {"qid": "int", "key": {"type": "string", "pattern": "^[A-F]$"}}
    },
    "answer.input": {
      "direction": "to_native",
      "islands": ["content"],
      "doc": "Grid-in text, already filtered to ^[-0-9./]*$, at most 5 characters.",
      "fields": {"qid": "int", "value": {"type": "string", "maxLength": 5, "pattern": "^[-0-9./]*$"}}
    },
    "answer.eliminate": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {"qid": "int", "key": {"type": "string", "pattern": "^[A-F]$"}, "on": "bool"}
    },
    "flag.toggle": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {"qid": "int"}
    },
    "eliminator.toggle": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {}
    },
    "selection": {
      "direction": "to_native",
      "islands": ["content"],
      "doc": "Mouse-up with a selection inside one container. rect is CSS px within the island (1 CSS px = 1 logical px).",
      "fields": {
        "selectionId": "string",
        "qid": "int",
        "container": {"enum": ["passage", "question", "choices"]},
        "start": "int",
        "end": "int",
        "text": {"type": "string", "maxLength": 500},
        "rect": {"ref": "Rect"}
      }
    },
    "selection.clear": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {}
    },
    "annot.click": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {
        "annotId": "string",
        "qid": "int",
        "container": {"enum": ["passage", "question", "choices"]},
        "rect": {"ref": "Rect"},
        "current": {"ref": "AnnotationStyle"}
      }
    },
    "annot.changed": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {
        "qid": "int",
        "container": {"enum": ["passage", "question", "choices"]},
        "list": {"array": {"ref": "Annotation"}}
      }
    },
    "selection.current": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {
        "req": "int",
        "qid": "int",
        "container": {"nullable": {"enum": ["passage", "question", "choices"]}},
        "text": {"nullable": {"type": "string", "maxLength": 500}}
      }
    },
    "key": {
      "direction": "to_native",
      "islands": ["content", "desmos"],
      "doc": "Content: only these keys, never while the SPR input has focus, never with Ctrl/Alt/Meta. Desmos: Escape only.",
      "fields": {
        "key": {"enum": ["ArrowLeft", "ArrowRight", "a", "b", "c", "d", "m", "r", "?", "Escape"]}
      }
    },
    "focus": {
      "direction": "to_native",
      "islands": ["content", "desmos"],
      "fields": {"inIsland": "bool"}
    },
    "split.changed": {
      "direction": "to_native",
      "islands": ["content"],
      "fields": {"split": "number"}
    },
    "error": {
      "direction": "to_native",
      "islands": ["content", "desmos"],
      "fields": {"where": {"type": "string", "maxLength": 200}, "message": {"type": "string", "maxLength": 2000}}
    },
    "desmos.init": {
      "direction": "to_web",
      "islands": ["desmos"],
      "fields": {"mode": {"enum": ["graphing", "scientific"]}, "state?": "any"}
    },
    "desmos.mode": {
      "direction": "to_web",
      "islands": ["desmos"],
      "fields": {"mode": {"enum": ["graphing", "scientific"]}}
    },
    "desmos.getState": {
      "direction": "to_web",
      "islands": ["desmos"],
      "fields": {"req": "int"}
    },
    "desmos.ready": {
      "direction": "to_native",
      "islands": ["desmos"],
      "fields": {"apiVersion": "string"}
    },
    "desmos.failed": {
      "direction": "to_native",
      "islands": ["desmos"],
      "doc": "Native then shows the scientific calculator (Dart port of expression.ts). timeout = 6 s.",
      "fields": {"reason": {"enum": ["offline", "script", "timeout"]}}
    },
    "desmos.changed": {
      "direction": "to_native",
      "islands": ["desmos"],
      "doc": "Debounced 2 s; native then sends desmos.getState and saves the state per attempt.",
      "fields": {}
    },
    "desmos.state": {
      "direction": "to_native",
      "islands": ["desmos"],
      "fields": {"req": "int", "state": "any"}
    }
  }
}
