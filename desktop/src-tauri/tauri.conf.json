{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterSAT",
  "version": "0.1.0",
  "identifier": "uz.mastersat.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5190",
    "beforeDevCommand": "npm --prefix app run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MasterSAT",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["mastersat"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MasterSAT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mastersat"]
      }
    }
  }
}
