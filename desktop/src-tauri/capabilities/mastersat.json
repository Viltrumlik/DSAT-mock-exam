{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mastersat",
  "description": "The bundled MasterSAT app (local content only) may drive the native lockdown. These commands are granted to the app's own window; the app ships its UI inside the .exe and never loads remote content, so no website can reach them.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-lockdown-precheck",
    "allow-lockdown-close-app",
    "allow-lockdown-enter",
    "allow-lockdown-prove",
    "allow-lockdown-exit",
    "allow-lockdown-heartbeat",
    "allow-battery-status",
    "allow-auth-begin",
    "allow-auth-take-verifier",
    "allow-open-external",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://mastersat.uz/*" }]
    }
  ]
}
